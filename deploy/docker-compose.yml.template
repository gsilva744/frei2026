name: feira-profissoes


services:

  feira-mysql:
    container_name: feira-mysql
    image: mysql:8.0
    env_file:
      - ./environment/mysql/.env
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -p$$MYSQL_ROOT_PASSWORD --silent"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 30s
    restart: unless-stopped
    ports:
      - "3306:3306"
    networks:
      - public


