PORT=5050
NODE_ENV=production

# Origens autorizadas a chamar a API pelo navegador — inclua a URL pública do web.
ALLOWED_ORIGINS=http://localhost:3000

# Host "feira-mysql" é o nome do serviço no docker-compose (rede interna "public"), não
# localhost. Usuário/senha/banco devem bater com deploy/environment/mysql/.env.
DATABASE_URL=mysql://feira:troque-por-outra-senha-forte@feira-mysql:3306/feira_frei_2026

# Segredos JWT — gere valores fortes e diferentes entre si (ex.: openssl rand -hex 32).
JWT_ACCESS_SECRET=troque-por-um-segredo-forte
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=outro-segredo-forte-diferente
JWT_REFRESH_EXPIRES_IN=7d

# Usados apenas por `npm run seed` (rode manualmente: docker compose exec api npm run seed).
# Uma conta por papel; remova o bloco de um papel que não vai usar.
ADMIN_SEED_NOME=Administrador da Feira
ADMIN_SEED_EMAIL=admin@feira.local
ADMIN_SEED_SENHA=troque-esta-senha

CREDENCIAMENTO_SEED_NOME=Equipe de Credenciamento
CREDENCIAMENTO_SEED_EMAIL=credenciamento@feira.local
CREDENCIAMENTO_SEED_SENHA=troque-esta-senha

LEITOR_SEED_NOME=Equipe do Leitor
LEITOR_SEED_EMAIL=leitor@feira.local
LEITOR_SEED_SENHA=troque-esta-senha
