# Credenciais da área administrativa (nunca publique o arquivo .env real).
RESTRICTED_AREA_USERNAME=seu-usuario
RESTRICTED_AREA_PASSWORD=sua-senha-segura

# MySQL (somente servidor; nunca use o prefixo VITE_ nestas variáveis)
# Use DATABASE_URL ou preencha cada MYSQL_* abaixo.
DATABASE_URL=mysql://usuario:senha@localhost:3306/feira_frei_2026
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=feira_frei_2026
# MYSQL_USER=usuario
# MYSQL_PASSWORD=senha
# MYSQL_SSL=false