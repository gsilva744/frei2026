# Copie este arquivo para wrangler.toml ao configurar o deploy no Cloudflare.
name = "feira-frei-2026"
compatibility_date = "2026-08-26"

# Este site não acessa banco de dados diretamente: toda a persistência é feita pela
# API (projeto `api/`), publicada separadamente. Configure VITE_API_URL como variável
# de build no Cloudflare Pages/Workers apontando para a URL pública dessa API.
