{
  "name": "feira-frei-2026-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API HTTP da 6ª Feira das Profissões 2026 (Node.js + Express ESM + MySQL).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
