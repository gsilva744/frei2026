# Servidor
PORT=5050
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# MySQL
DATABASE_URL=mysql://usuario:senha@localhost:3306/feira_frei_2026

# JWT (troque por segredos fortes e diferentes entre si em produção)
JWT_ACCESS_SECRET=troque-por-um-segredo-forte
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=outro-segredo-forte-diferente
JWT_REFRESH_EXPIRES_IN=7d

# Usados apenas por `npm run seed` para criar o primeiro administrador
ADMIN_SEED_NOME=Administrador da Feira
ADMIN_SEED_EMAIL=admin@feira.local
ADMIN_SEED_SENHA=troque-esta-senha
